{
  "manifest_version": 3,
  "name": "SnapNote AI",
  "version": "0.1.0",
  "description": "Capture lecture screenshots → clean markdown notes with one click",
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": ["https://api.snapnote.ai/*", "https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://learn.iitm.ac.in/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "capture-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "MacCtrl+Shift+T"
      },
      "description": "Extract text/table from screen"
    },
    "capture-diagram": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "MacCtrl+Shift+D"
      },
      "description": "Extract diagram from screen"
    }
  }
}
