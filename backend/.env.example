# SnapNote AI backend — copy to .env and fill real values. Never commit .env.
DEBUG=false
APP_NAME=SnapNote AI

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ImgBB — https://api.imgbb.com/  (MVP image hosting)
IMGBB_API_KEY=your_imgbb_api_key_here

# Pollinations — https://pollinations.ai  (empty = anonymous tier)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=sana

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Development only: lets /verify complete mock_* orders with any signature.
# Ignored unless DEBUG=true. NEVER enable on a production deployment.
PAYMENTS_MOCK=false

# Storage / DB
CREDITS_DB_PATH=credits.db
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=snapnote-diagrams
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Auth
# Must be a random value of at least 32 chars. A missing/placeholder secret is
# replaced at startup (persisted beside an absolute CREDITS_DB_PATH) and
# /health reports auth_secret_configured=false until a real one is set.
JWT_SECRET=change-this-to-a-random-32-char-string-in-production
JWT_EXPIRES_HOURS=168
GOOGLE_CLIENT_ID=112530923487-6kjt4rvk765lekhd55fpeeu5fg1dh49e.apps.googleusercontent.com
# Comma-separated extra OAuth client IDs accepted by /api/auth/chrome
# (e.g. the Chrome extension's client id). Falls back to GOOGLE_CLIENT_ID.
GOOGLE_ALLOWED_CLIENT_IDS=

# CORS: "*" allows any origin without credentials (the API uses bearer
# headers, not cookies). Set explicit origins if credentialed CORS is needed.
CORS_ALLOW_ORIGINS=*

# Limits
FREE_CREDITS_MONTHLY=50
ANONYMOUS_FREE_USES=1
DAILY_REQ_LIMIT=50
RATE_LIMIT_PER_MIN=10
MAX_IMAGE_SIZE_MB=10
# Header-only pixel budget; refuses decompression bombs before decoding.
MAX_SOURCE_MEGAPIXELS=24

