DEBUG=true

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Pollinations (Explain Visually image generation). Empty = anonymous free
# tier (1 req / 15s). A free registered key (enter.pollinations.ai) lifts it to
# 1 req / 5s — recommended for the MVP.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=sana

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=snapnote-diagrams
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
