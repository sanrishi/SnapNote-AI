# SnapNote AI — copy to .env (or backend/.env) and fill real values. Never commit .env.
DEBUG=false
APP_NAME=SnapNote AI
APP_VERSION=0.1.0

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ImgBB — https://api.imgbb.com/  (used for MVP image hosting)
IMGBB_API_KEY=your_imgbb_api_key_here

# Pollinations — https://pollinations.ai  (image generation; empty = anonymous tier)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=sana

# Firebase — backend/firebase-credentials.json (gitignored)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Storage / DB
CREDITS_DB_PATH=/data/credits.db
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=snapnote-diagrams
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string-in-production
JWT_EXPIRES_HOURS=168

# Limits
FREE_CREDITS_MONTHLY=50
ANONYMOUS_FREE_USES=1
DAILY_REQ_LIMIT=50
RATE_LIMIT_PER_MIN=10
MAX_IMAGE_SIZE_MB=10
